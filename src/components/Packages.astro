---
import type { Dict, Lang } from '../i18n/utils';

interface Props {
  t?: Dict;
  lang: Lang;
}

const { lang } = Astro.props;
const en = lang === 'en';

const packages = en
  ? [
  {
    id: "lanzar",
    name: "Launch",
    price: "$600",
    priceLabel: "Starting at · before tax",
    delivery: "2-3 wk",
    headline: "Professional landing page",
    body: "You have an idea and need an online presence now. Responsive site, basic SEO, hosting and domain included.",
    features: [
      "Custom multi-section landing page",
      "Responsive + basic SEO",
      "Domain and hosting included",
      "Delivered in 2-3 weeks",
    ],
    cta: "I want my landing page",
    href: "https://wa.me/50685082921?text=Hi Jonathan! I'm interested in the Launch package.",
    highlighted: false,
  },
  {
    id: "crecer",
    name: "Grow",
    price: "$1,500",
    priceLabel: "Starting at · before tax",
    delivery: "4-8 wk",
    headline: "Full website or mobile app",
    body: "Your business is already running. You need a multi-page website with a CMS or a mobile app with a backend. 1 month of support included.",
    features: [
      "Multi-page website + CMS, or mobile app (Flutter)",
      "Node backend if the app needs it",
      "SEO + analytics",
      "1 month of post-delivery support",
      "Delivered in 4-8 weeks",
    ],
    cta: "Let's talk about Grow",
    href: "https://wa.me/50685082921?text=Hi Jonathan! I'm interested in the Grow package.",
    highlighted: true,
    badge: "Most popular",
  },
  {
    id: "escalar",
    name: "Scale",
    price: "Custom quote",
    priceLabel: "Tailored pricing",
    delivery: "Based on scope",
    headline: "Serious product + modern integrations",
    body: "When the project grows and needs real architecture. A web or mobile app with a backend, AI integrations, real-time features and everything a serious product needs to scale.",
    features: [
      "Complete web or mobile app with a custom backend",
      "AI integrations: LLMs, RAG, agents, embeddings",
      "Real time with websockets + live updates",
      "Online payments (Stripe, SINPE, PayPal)",
      "Auth, admin panels, multi-tenancy",
      "Clean architecture · SOLID · DRY · CI/CD",
      "3 months of post-delivery support",
    ],
    cta: "Let's talk scope",
    href: "https://wa.me/50685082921?text=Hi Jonathan! I'd like to talk about a custom project (Scale).",
    highlighted: false,
  },
]
  : [
  {
    id: "lanzar",
    name: "Lanzar",
    price: "$600",
    priceLabel: "Desde · sin IVA",
    delivery: "2-3 sem",
    headline: "Landing page profesional",
    body: "Vos tenés una idea y necesitás presencia online ya. Sitio responsive, SEO básico, hosting y dominio incluidos.",
    features: [
      "Landing multi-sección a medida",
      "Responsive + SEO básico",
      "Dominio y hosting incluidos",
      "Entrega 2-3 semanas",
    ],
    cta: "Quiero mi landing",
    href: "https://wa.me/50685082921?text=¡Hola, Jonathan! Me interesa el paquete Lanzar.",
    highlighted: false,
  },
  {
    id: "crecer",
    name: "Crecer",
    price: "$1.500",
    priceLabel: "Desde · sin IVA",
    delivery: "4-8 sem",
    headline: "Web completa o app móvil",
    body: "Tu negocio ya rueda. Necesitás web multi-página con CMS o app móvil con backend. Soporte 1 mes incluido.",
    features: [
      "Web multi-página + CMS, o app móvil (Flutter)",
      "Backend Node si la app lo requiere",
      "SEO + analytics",
      "1 mes de soporte post-entrega",
      "Entrega 4-8 semanas",
    ],
    cta: "Hablemos de Crecer",
    href: "https://wa.me/50685082921?text=¡Hola, Jonathan! Me interesa el paquete Crecer.",
    highlighted: true,
    badge: "Más elegido",
  },
  {
    id: "escalar",
    name: "Escalar",
    price: "Bajo cotización",
    priceLabel: "Cotización a medida",
    delivery: "Según scope",
    headline: "Producto serio + integraciones modernas",
    body: "Cuando el proyecto crece y necesita arquitectura real. App web o móvil con backend, integraciones con IA, tiempo real y todo lo que un producto serio necesita para escalar.",
    features: [
      "App web o móvil completa con backend a medida",
      "Integraciones con IA: LLMs, RAG, agentes, embeddings",
      "Tiempo real con websockets + live updates",
      "Pagos online (Stripe, SINPE, PayPal)",
      "Auth, paneles admin, multi-tenancy",
      "Clean architecture · SOLID · DRY · CI/CD",
      "3 meses de soporte post-entrega",
    ],
    cta: "Hablemos del scope",
    href: "https://wa.me/50685082921?text=¡Hola, Jonathan! Quiero hablar de un proyecto a medida (Escalar).",
    highlighted: false,
  },
];
---

<section id="paquetes" class="border-b" style="border-color: var(--color-line);">
  <div class="container-x py-20 md:py-28">
    <div class="grid gap-10 lg:grid-cols-[1.4fr_1fr] lg:gap-16 mb-14 md:mb-20">
      <div class="reveal">
        <div class="label mb-4">{en ? 'Packages · clear starting prices' : 'Paquetes · precio claro de entrada'}</div>
        <h2 class="display-xl" style="color: var(--color-text);">
          {en ? 'Three paths.' : 'Tres caminos.'}<br />
          {en ? 'Zero ' : 'Cero '}<span class="mark-accent">{en ? 'surprises' : 'sorpresas'}</span>{en ? ' on the invoice.' : ' en la factura.'}
        </h2>
      </div>
      <p
        class="reveal reveal-d1 text-[1.0625rem] leading-relaxed self-end max-w-[52ch]"
        style="color: var(--color-text-mute);"
      >
        {
          en
            ? 'Starting prices. What changes is the scope — and we define that before writing any code. Post-delivery support included in the two larger packages.'
            : 'Precios de entrada. Lo que cambia es el alcance — y eso lo definimos antes de tocar código. Soporte post-entrega incluido en los dos paquetes mayores.'
        }
      </p>
    </div>

    <div id="paquete-lanzar" class="grid gap-5 md:gap-6 lg:grid-cols-3">
      {packages.map((pkg, i) => (
        <article
          id={`paquete-${pkg.id}`}
          class={`reveal reveal-d${i + 1} relative p-7 md:p-8 flex flex-col`}
          style={pkg.highlighted
            ? "background-color: var(--color-accent); color: var(--color-bg); border: 1px solid var(--color-accent); border-radius: 16px;"
            : "background-color: var(--color-surface); border: 1px solid var(--color-line); border-radius: 16px;"
          }
        >
          {pkg.badge && (
            <div
              class="absolute -top-3 left-7 px-2.5 py-1 rounded-full text-[0.68rem] font-bold uppercase font-mono"
              style="background-color: var(--color-bg); color: var(--color-accent); letter-spacing: 0.15em; border: 1px solid var(--color-accent);"
            >
              {pkg.badge}
            </div>
          )}

          <div class="flex items-baseline justify-between mb-7">
            <h3
              class="display-l"
              style={`font-size: 1.875rem; color: ${pkg.highlighted ? 'var(--color-bg)' : 'var(--color-text)'};`}
            >
              {pkg.name}
            </h3>
            <span
              class="label"
              style={`color: ${pkg.highlighted ? 'rgba(14,14,16,0.65)' : 'var(--color-text-mute)'};`}
            >
              {pkg.delivery}
            </span>
          </div>

          <div class="mb-6">
            <div
              class={`font-display leading-none ${pkg.price.startsWith('$') ? 'tabular-nums' : ''}`}
              style={`font-size: ${pkg.price.startsWith('$') ? 'clamp(2.5rem, 4vw, 3rem)' : 'clamp(1.5rem, 2.4vw, 1.875rem)'}; letter-spacing: -0.04em; color: ${pkg.highlighted ? 'var(--color-bg)' : 'var(--color-text)'};`}
            >
              {pkg.price}
            </div>
            <div
              class="label mt-2"
              style={`color: ${pkg.highlighted ? 'rgba(14,14,16,0.65)' : 'var(--color-text-mute)'};`}
            >
              {pkg.priceLabel}
            </div>
          </div>

          <div
            class="text-[0.95rem] font-medium leading-snug mb-3"
            style={`color: ${pkg.highlighted ? 'var(--color-bg)' : 'var(--color-text)'};`}
          >
            {pkg.headline}
          </div>
          <p
            class="text-[0.875rem] leading-relaxed mb-6"
            style={`color: ${pkg.highlighted ? 'rgba(14,14,16,0.78)' : 'var(--color-text-mute)'};`}
          >
            {pkg.body}
          </p>

          <ul class="space-y-2.5 mb-8 flex-1">
            {pkg.features.map((f) => (
              <li class="flex items-start gap-2.5 text-[0.875rem]">
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="mt-0.5 shrink-0"
                  style={`color: ${pkg.highlighted ? 'var(--color-bg)' : 'var(--color-success)'};`}
                >
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span style={`color: ${pkg.highlighted ? 'var(--color-bg)' : 'var(--color-text)'};`}>{f}</span>
              </li>
            ))}
          </ul>

          <a
            href={pkg.href}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-full font-semibold text-[0.9rem] transition-colors duration-200"
            style={pkg.highlighted
              ? "background-color: var(--color-bg); color: var(--color-text);"
              : "background-color: var(--color-accent); color: var(--color-bg);"
            }
          >
            {pkg.cta}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </article>
      ))}
    </div>

    <p class="mt-10 text-[0.85rem] text-center reveal" style="color: var(--color-text-mute);">
      {en ? 'Need something different?' : '¿Necesitás algo distinto?'} <a href="https://wa.me/50685082921" target="_blank" rel="noopener noreferrer" class="underline" style="color: var(--color-accent);">{en ? "Let's talk on WhatsApp" : 'Hablemos por WhatsApp'}</a> {en ? "and we'll put together something custom." : 'y armamos algo a medida.'}
    </p>
  </div>
</section>
