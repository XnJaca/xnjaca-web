---
import type { Dict } from '../i18n/utils';

interface Props {
  t: Dict;
}

const { t } = Astro.props;
---

<section id="contacto" class="border-b relative overflow-hidden" style="border-color: var(--color-line); background-color: var(--color-bg);">
  <div class="container-x py-20 md:py-28">
    <div class="grid gap-12 lg:grid-cols-[1.4fr_1fr] lg:gap-16 lg:items-end">
      <div class="reveal">
        <div class="label mb-5" style="color: var(--color-accent);">Próximo paso</div>
        <h2 class="display-mega" style="color: var(--color-text); font-size: clamp(2.5rem, 7vw, 5.5rem);">
          ¿Hablamos<br />
          de tu <span class="mark-accent">proyecto?</span>
        </h2>
        <p class="mt-8 max-w-[52ch] text-[1.0625rem] leading-relaxed" style="color: var(--color-text-mute);">
          Respondo en menos de 24 horas hábiles. Para algo rápido, WhatsApp. Para algo largo, email. <strong style="color: var(--color-text); font-weight: 600;">Mandá mensaje cuando quieras.</strong>
        </p>

        <div class="mt-10 flex flex-wrap gap-3">
          <a
            href="https://wa.me/50685082921?text=¡Hola, Jonathan! Vi tu sitio y quería conversar sobre un proyecto."
            target="_blank"
            rel="noopener noreferrer"
            class="btn-wa"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.002-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
            </svg>
            WhatsApp
          </a>
          <a href="mailto:xnjaca@gmail.com" class="btn-ghost">
            xnjaca@gmail.com
          </a>
        </div>
      </div>

      <aside class="reveal reveal-d1 lg:pb-2">
        <div class="surface p-7">
          <div class="label mb-5">Datos</div>
          <dl class="space-y-5">
            <div>
              <dt class="label mb-1.5">WhatsApp</dt>
              <dd>
                <a href="https://wa.me/50685082921" target="_blank" rel="noopener noreferrer" class="text-[1.0625rem] tabular-nums font-medium hover:underline" style="color: var(--color-text);">+506 8508 2921</a>
              </dd>
            </div>
            <div>
              <dt class="label mb-1.5">Email</dt>
              <dd>
                <a href="mailto:xnjaca@gmail.com" class="text-[1.0625rem] hover:underline" style="color: var(--color-text);">xnjaca@gmail.com</a>
              </dd>
            </div>
            <div>
              <dt class="label mb-1.5">LinkedIn</dt>
              <dd>
                <a href="https://www.linkedin.com/in/xnjaca/" target="_blank" rel="noopener noreferrer" class="text-[1.0625rem] hover:underline" style="color: var(--color-text);">linkedin.com/in/xnjaca</a>
              </dd>
            </div>
            <div>
              <dt class="label mb-1.5">Ubicación</dt>
              <dd class="text-[1.0625rem]" style="color: var(--color-text);">San José, Costa Rica · GMT-6</dd>
            </div>
          </dl>
        </div>
      </aside>
    </div>
  </div>
</section>
