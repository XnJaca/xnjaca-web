---
import type { Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const en = lang === 'en';

const steps = en
  ? [
      {
        n: "01",
        title: "Conversation",
        body: "Before touching code, we understand what your business needs. One call to learn the real problem: what you solve, for whom, and what counts as success. If I'm not the right fit, I'll tell you right away.",
      },
      {
        n: "02",
        title: "Prototype",
        body: "A clickable version fast, before investing weeks. Mockups or a working prototype to validate direction. We iterate until the what is clear. This saves costly changes later.",
      },
      {
        n: "03",
        title: "Development",
        body: "I show you progress, not just the final result. Visible, steady updates throughout. Your feedback at any time. If something falls outside scope, we talk about it before moving on.",
      },
      {
        n: "04",
        title: "Delivery + support",
        body: "A product in production, documented, and 100% yours. Deploy, documentation and a technical walkthrough. The code is yours from day one. Post-delivery support in the Grow and Scale packages.",
      },
    ]
  : [
  {
    n: "01",
    title: "Conversación",
    body: "Antes de tocar código, entendemos qué necesita tu negocio. Una llamada para conocer el problema real: qué resolvés, para quién, qué cuenta como éxito. Si no soy el indicado, te lo digo de una.",
  },
  {
    n: "02",
    title: "Prototipo",
    body: "Una versión navegable rápido, antes de invertir semanas. Maquetas o prototipo funcional para validar dirección. Iteramos hasta que el qué esté claro. Esto ahorra cambios caros después.",
  },
  {
    n: "03",
    title: "Desarrollo",
    body: "Te muestro el avance, no solo el resultado final. Avances visibles y constantes durante toda la fase. Tu feedback en cualquier momento. Si algo se sale de scope, lo conversamos antes de seguir.",
  },
  {
    n: "04",
    title: "Entrega + soporte",
    body: "Producto en producción, documentado, y 100% tuyo. Deploy, documentación y walkthrough técnico. El código es tuyo desde día uno. Soporte post-entrega en los paquetes Crecer y Escalar.",
  },
    ];
---

<section id="proceso" class="border-b" style="border-color: var(--color-line); background-color: var(--color-surface);">
  <div class="container-x py-20 md:py-28">
    <div class="grid gap-10 lg:grid-cols-[1.2fr_1fr] lg:gap-16 mb-14 md:mb-20">
      <div class="reveal">
        <div class="label mb-4">{en ? 'How I work' : 'Cómo trabajo'}</div>
        <h2 class="display-xl" style="color: var(--color-text);">
          {en ? 'A process that respects' : 'Un proceso que respeta'}<br />
          {en ? 'your ' : 'tu '}<span class="mark-accent">{en ? 'time' : 'tiempo'}</span>{en ? ' and your money.' : ' y tu plata.'}
        </h2>
      </div>
      <p
        class="reveal reveal-d1 text-[1.0625rem] leading-relaxed self-end max-w-[52ch]"
        style="color: var(--color-text-mute);"
      >
        {
          en
            ? 'Four steps. Zero surprises. Before we start you know what gets delivered, when, and what it costs. After that, optional maintenance.'
            : 'Cuatro pasos. Cero sorpresas. Antes de empezar sabés qué se entrega, cuándo y qué cuesta. Después, mantenimiento opcional.'
        }
      </p>
    </div>

    <ol class="grid gap-px md:grid-cols-2 lg:grid-cols-4 surface overflow-hidden">
      {steps.map((step, i) => (
        <li class={`p-7 md:p-8 reveal reveal-d${i + 1}`} style="background-color: var(--color-surface);">
          <div
            class="font-display tabular-nums leading-none mb-7"
            style="font-size: 2.5rem; letter-spacing: -0.04em; color: var(--color-accent);"
          >
            {step.n}
          </div>
          <h3 class="display-l mb-4" style="font-size: 1.25rem; color: var(--color-text);">
            {step.title}
          </h3>
          <p class="text-[0.875rem] leading-relaxed" style="color: var(--color-text-mute);">
            {step.body}
          </p>
        </li>
      ))}
    </ol>
  </div>
</section>
