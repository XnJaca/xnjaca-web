---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import type { Dict, Lang } from '../i18n/utils';
import { showPackages } from '../utils/flags';

interface ProjectData {
  pageTitle: string;
  pageDescription: string;
  label: string;
  name: string;
  tagline: string;
  context: string;
  problem: string;
  problemQuote: string;
  role: string;
  solution: readonly string[];
  stackGroups: readonly { area: string; techs: string }[];
  status: string;
  externalUrl: string | null;
  externalLabel: string | null;
  screenshots: readonly { src: string; alt: string }[];
  roadmap: readonly { period: string; headline: string; detail: string }[];
}

interface Props {
  project: ProjectData;
  lang: Lang;
  t: Dict;
}

const { project, lang, t } = Astro.props;
const labels = t.projectPages;
const en = lang === 'en';
const backHref = lang === 'en' ? '/projects/' : '/es/projects/';
const waMessage = encodeURIComponent(
  en
    ? `Hi Jonathan! I saw the ${project.name} case study and would like to talk.`
    : `¡Hola, Jonathan! Vi el caso de estudio de ${project.name} y quería conversar.`,
);
const waHref = `https://wa.me/50685082921?text=${waMessage}`;

const hasScreenshots = project.screenshots.length > 0;
const hasRoadmap = project.roadmap.length > 0;
---

<BaseLayout
  title={project.pageTitle}
  description={project.pageDescription}
  lang={lang}
  noStructuredData
>
  <Nav lang={lang} t={t} />

  <main>
    <section class="container-x relative pt-12 md:pt-20 pb-16 md:pb-24">
      <a
        href={backHref}
        class="reveal inline-flex items-center gap-2 text-[0.85rem] font-medium mb-10 transition-colors"
        style="color: var(--color-text-mute);"
        onmouseover="this.style.color='var(--color-accent)'"
        onmouseout="this.style.color='var(--color-text-mute)'"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        {labels.back}
      </a>

      <div class="grid gap-12 lg:grid-cols-[1.6fr_1fr] lg:gap-16 lg:items-end">
        <div>
          <div class="label reveal mb-7" style="color: var(--color-accent);">
            {project.label}
          </div>

          <h1
            class="reveal reveal-d1 display-mega"
            style="color: var(--color-text);"
          >
            {project.name}
          </h1>

          <p
            class="reveal reveal-d2 mt-8 max-w-[44ch]"
            style="font-size: clamp(1.125rem, 1.6vw, 1.375rem); line-height: 1.4; color: var(--color-text);"
          >
            {project.tagline}
          </p>

          <div class="reveal reveal-d3 mt-10 flex flex-wrap items-center gap-3">
            {project.externalUrl && (
              <a
                href={project.externalUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-primary"
              >
                {labels.visitSite}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="7" y1="17" x2="17" y2="7"></line>
                  <polyline points="7 7 17 7 17 17"></polyline>
                </svg>
              </a>
            )}
            <a
              href={waHref}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-ghost"
            >
              {en ? "Let's talk on WhatsApp" : 'Conversemos por WhatsApp'}
            </a>
          </div>
        </div>

        <aside class="reveal reveal-d2 lg:pb-3 self-end">
          <div class="surface p-6 md:p-7">
            <div class="space-y-5">
              <div>
                <div class="label mb-1.5">Estado</div>
                <div class="text-[0.95rem] font-medium" style="color: var(--color-text);">
                  {project.status}
                </div>
              </div>
              {project.externalUrl && (
                <div class="pt-5 border-t" style="border-color: var(--color-line);">
                  <div class="label mb-1.5">En vivo</div>
                  <a
                    href={project.externalUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-[0.95rem] font-medium inline-flex items-center gap-1.5 hover:underline"
                    style="color: var(--color-accent);"
                  >
                    {project.externalLabel ?? project.externalUrl}
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="7" y1="17" x2="17" y2="7"></line>
                      <polyline points="7 7 17 7 17 17"></polyline>
                    </svg>
                  </a>
                </div>
              )}
            </div>
          </div>
        </aside>
      </div>
    </section>

    <section class="border-y" style="border-color: var(--color-line); background-color: var(--color-surface);">
      <div class="container-x py-16 md:py-24">
        <div class="grid gap-10 lg:grid-cols-[1fr_1.6fr] lg:gap-16">
          <div class="reveal">
            <div class="label mb-4">{en ? '01 · The context' : '01 · El contexto'}</div>
            <h2 class="display-xl" style="color: var(--color-text); font-size: clamp(1.875rem, 3.5vw, 3rem);">
              {en ? 'What it is and ' : '¿Qué es y para '}<span class="mark-accent">{en ? 'who it serves.' : 'quién?'}</span>
            </h2>
          </div>
          <p class="reveal reveal-d1 text-[1.0625rem] md:text-[1.125rem] leading-relaxed self-end max-w-[60ch]" style="color: var(--color-text);">
            {project.context}
          </p>
        </div>
      </div>
    </section>

    <section class="container-x py-16 md:py-24">
      <div class="grid gap-12 lg:grid-cols-[1.6fr_1fr] lg:gap-16">
        <div class="reveal">
          <div class="label mb-4">{en ? '02 · The problem' : '02 · El problema'}</div>
          <h2 class="display-xl" style="color: var(--color-text);">
            {en ? "What's " : 'Lo que está '}<span class="mark-accent">{en ? 'broken' : 'roto'}</span>.
          </h2>
          <p class="mt-8 text-[1.0625rem] leading-relaxed max-w-[58ch]" style="color: var(--color-text-mute);">
            {project.problem}
          </p>
        </div>

        <aside class="reveal reveal-d1 lg:pb-1 self-end">
          <blockquote
            class="surface p-7 md:p-8 relative"
            style="border-left: 4px solid var(--color-accent);"
          >
            <svg
              aria-hidden="true"
              width="38"
              height="30"
              viewBox="0 0 38 30"
              fill="none"
              style="color: var(--color-accent); margin-bottom: 1rem; opacity: 0.85;"
            >
              <path d="M0 30V18C0 9.5 4 3.5 12 0V6C8 8 6 12 6 18H10V30H0ZM21 30V18C21 9.5 25 3.5 33 0V6C29 8 27 12 27 18H31V30H21Z" fill="currentColor" />
            </svg>
            <p
              class="font-display"
              style="font-size: clamp(1.25rem, 1.8vw, 1.625rem); font-weight: 600; line-height: 1.25; letter-spacing: -0.02em; color: var(--color-text);"
            >
              {project.problemQuote}
            </p>
          </blockquote>
        </aside>
      </div>
    </section>

    <section class="border-y" style="border-color: var(--color-line); background-color: var(--color-surface);">
      <div class="container-x py-16 md:py-24">
        <div class="grid gap-10 lg:grid-cols-[1fr_1.6fr] lg:gap-16">
          <div class="reveal">
            <div class="label mb-4">{en ? '03 · My role' : '03 · Mi rol'}</div>
            <h2 class="display-xl" style="color: var(--color-text); font-size: clamp(1.875rem, 3.5vw, 3rem);">
              {en ? 'What I ' : 'Qué '}<span class="mark-accent">{en ? 'did' : 'hice'}</span>.
            </h2>
          </div>
          <p class="reveal reveal-d1 text-[1.0625rem] leading-relaxed self-end max-w-[60ch]" style="color: var(--color-text);">
            {project.role}
          </p>
        </div>
      </div>
    </section>

    <section class="container-x py-16 md:py-24">
      <div class="mb-12 md:mb-16 reveal">
        <div class="label mb-4">{en ? '04 · The solution' : '04 · La solución'}</div>
        <h2 class="display-xl max-w-[20ch]" style="color: var(--color-text);">
          {en ? 'What exactly I ' : 'Qué '}<span class="mark-accent">{en ? 'built' : 'construí'}</span>{en ? '.' : ' exactamente.'}
        </h2>
      </div>
      <ol class="grid gap-x-12 gap-y-7 md:grid-cols-2 max-w-[1100px]">
        {project.solution.map((item, i) => (
          <li class={`flex items-start gap-5 reveal reveal-d${(i % 4) + 1} pt-5 border-t`} style="border-color: var(--color-line);">
            <span
              class="font-display tabular-nums leading-none shrink-0"
              style="font-weight: 700; font-size: 1.5rem; color: var(--color-accent); letter-spacing: -0.03em; min-width: 2.5rem;"
            >
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="text-[1rem] leading-relaxed" style="color: var(--color-text);">{item}</span>
          </li>
        ))}
      </ol>
    </section>

    <section class="border-y" style="border-color: var(--color-line); background-color: var(--color-surface);">
      <div class="container-x py-16 md:py-24">
        <div class="mb-10 md:mb-14 reveal">
          <div class="label mb-4">{en ? '05 · Stack & architecture' : '05 · Stack & arquitectura'}</div>
          <h2 class="display-xl max-w-[18ch]" style="color: var(--color-text);">
            {en ? 'Built ' : 'Con '}<span class="mark-accent">{en ? 'with' : 'qué'}</span>.
          </h2>
        </div>
        <div class="surface overflow-hidden reveal reveal-d1" style="background-color: var(--color-bg);">
          {project.stackGroups.map((g, i) => (
            <div
              class={`grid gap-4 md:grid-cols-[200px_1fr] md:gap-8 px-6 md:px-8 py-5 md:py-6 ${i < project.stackGroups.length - 1 ? 'border-b' : ''}`}
              style="border-color: var(--color-line);"
            >
              <div class="label" style="color: var(--color-accent);">
                {g.area}
              </div>
              <div class="font-mono text-[0.95rem]" style="color: var(--color-text);">
                {g.techs}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    {hasScreenshots && (
      <section class="container-x py-16 md:py-24">
        <div class="flex items-baseline justify-between gap-4 mb-10 md:mb-14 reveal">
          <div>
            <div class="label mb-4">{en ? '06 · Screenshots' : '06 · Capturas'}</div>
            <h2 class="display-xl" style="color: var(--color-text); font-size: clamp(1.875rem, 3.5vw, 3rem);">
              {en ? 'How it ' : 'Cómo se '}<span class="mark-accent">{en ? 'looks' : 've'}</span>.
            </h2>
          </div>
          <div data-counter class="label tabular-nums shrink-0">
            1 / {project.screenshots.length}
          </div>
        </div>

        <div class="relative reveal reveal-d1">
          <div
            data-slider
            class="scrollbar-hidden flex gap-4 md:gap-6 overflow-x-auto snap-x snap-mandatory -mx-6 px-6 md:-mx-12 md:px-12 pb-2"
          >
            {project.screenshots.map((shot) => (
              <figure class="snap-start shrink-0 w-[88%] md:w-[78%] lg:w-[72%]">
                <img
                  src={shot.src}
                  alt={shot.alt}
                  loading="lazy"
                  class="block w-full h-auto rounded-2xl border"
                  style="border-color: var(--color-line);"
                />
              </figure>
            ))}
          </div>

          <div class="mt-6 flex items-center justify-end gap-2.5">
            <button data-prev type="button" aria-label="Anterior" class="slider-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
              </svg>
            </button>
            <button data-next type="button" aria-label="Siguiente" class="slider-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </button>
          </div>
        </div>

        <style>
          .scrollbar-hidden { scrollbar-width: none; }
          .scrollbar-hidden::-webkit-scrollbar { display: none; }
          .slider-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            border-radius: 999px;
            background-color: var(--color-surface);
            color: var(--color-text);
            border: 1px solid var(--color-line);
            transition: background-color 180ms var(--ease-snap), border-color 180ms var(--ease-snap);
          }
          .slider-btn:hover { background-color: var(--color-surface-2); border-color: var(--color-accent); color: var(--color-accent); }
          .slider-btn:disabled { opacity: 0.35; cursor: not-allowed; }
          .slider-btn:disabled:hover { background-color: var(--color-surface); border-color: var(--color-line); color: var(--color-text); }
        </style>

        <script>
          function initSlider() {
            const slider = document.querySelector('[data-slider]');
            const prev = document.querySelector('[data-prev]');
            const next = document.querySelector('[data-next]');
            const counter = document.querySelector('[data-counter]');
            if (!slider || !prev || !next || !counter) return;
            const slides = Array.from(slider.querySelectorAll('figure'));
            const total = slides.length;
            if (total === 0) return;

            function current() {
              const gap = parseFloat(getComputedStyle(slider).gap || '0');
              const step = slides[0].offsetWidth + gap;
              return Math.round(slider.scrollLeft / step);
            }
            function update() {
              const i = current();
              counter.textContent = (i + 1) + ' / ' + total;
              prev.disabled = i <= 0;
              next.disabled = i >= total - 1;
            }
            function go(delta) {
              const target = Math.max(0, Math.min(total - 1, current() + delta));
              const gap = parseFloat(getComputedStyle(slider).gap || '0');
              const step = slides[0].offsetWidth + gap;
              slider.scrollTo({ left: target * step, behavior: 'smooth' });
            }
            prev.addEventListener('click', () => go(-1));
            next.addEventListener('click', () => go(1));
            slider.addEventListener('scroll', () => window.requestAnimationFrame(update));
            update();
          }
          initSlider();
          document.addEventListener('astro:after-swap', initSlider);
        </script>
      </section>
    )}

    {hasRoadmap && (
      <section class="border-y" style="border-color: var(--color-line); background-color: var(--color-surface);">
        <div class="container-x py-16 md:py-24">
          <div class="mb-10 md:mb-14 reveal">
            <div class="label mb-4">07 · Roadmap</div>
            <h2 class="display-xl max-w-[20ch]" style="color: var(--color-text);">
              {en ? 'Where it ' : 'Hacia '}<span class="mark-accent">{en ? 'goes next' : 'dónde'}</span>{en ? '.' : ' va.'}
            </h2>
          </div>
          <ol class="flex flex-col gap-8 md:gap-10 max-w-3xl">
            {project.roadmap.map((item, i) => (
              <li class={`grid grid-cols-[5rem_1fr] md:grid-cols-[7.5rem_1fr] gap-5 md:gap-8 items-start reveal reveal-d${Math.min(i + 1, 5)} pt-5 border-t`} style="border-color: var(--color-line);">
                <div class="flex items-center gap-2">
                  <span
                    class="inline-block h-1.5 w-1.5 rounded-full shrink-0"
                    style="background-color: var(--color-accent);"
                  ></span>
                  <span
                    class="label tabular-nums"
                    style="color: var(--color-accent);"
                  >
                    {item.period}
                  </span>
                </div>
                <div>
                  <h3
                    class="font-display font-medium leading-snug"
                    style="font-size: clamp(1.125rem, 2vw, 1.5rem); letter-spacing: -0.02em; color: var(--color-text);"
                  >
                    {item.headline}
                  </h3>
                  <p
                    class="mt-2 text-[0.95rem] leading-relaxed"
                    style="color: var(--color-text-mute);"
                  >
                    {item.detail}
                  </p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )}

    <section class="container-x py-16 md:py-24">
      <div class="surface p-8 md:p-12 reveal">
        <div class="grid gap-8 lg:grid-cols-[1.5fr_1fr] lg:gap-12 lg:items-center">
          <div>
            <div class="label mb-4">{en ? 'Want something similar?' : '¿Querés algo parecido?'}</div>
            <h2 class="display-xl" style="color: var(--color-text); font-size: clamp(1.875rem, 3.6vw, 2.75rem);">
              {en ? "Let's talk about " : 'Hablemos del '}<span class="mark-accent">{en ? 'yours' : 'tuyo'}</span>.
            </h2>
            <p class="mt-5 max-w-[52ch] text-[1rem] leading-relaxed" style="color: var(--color-text-mute);">
              {en ? 'Quick quote via WhatsApp or email. I reply within one business day.' : 'Cotización rápida por WhatsApp o email. Respondo en menos de 24 horas hábiles.'}
            </p>
          </div>
          <div class="flex flex-wrap gap-3 lg:justify-end">
            <a
              href={waHref}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-wa"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.002-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
              </svg>
              WhatsApp
            </a>
            {showPackages && (
              <a href={lang === 'en' ? '/#paquetes' : '/es/#paquetes'} class="btn-ghost">
                {en ? 'See packages' : 'Ver paquetes'}
              </a>
            )}
          </div>
        </div>
      </div>
    </section>

    <section class="container-x py-10 border-t" style="border-color: var(--color-line);">
      <a
        href={backHref}
        class="group inline-flex items-center gap-2 text-[0.9rem] font-medium transition-opacity hover:opacity-70"
        style="color: var(--color-text);"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:-translate-x-0.5">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>{labels.back}</span>
      </a>
    </section>
  </main>

  <Footer t={t} lang={lang} />
</BaseLayout>
