---
import { showPackages } from '../utils/flags';
import type { Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const en = lang === 'en';

const questions = [
  {
    n: "01",
    q: en ? "Does your business need custom software?" : "¿Tu negocio necesita un software a la medida?",
    a: en
      ? "Management systems, dashboards, integrations, internal apps. I build the digital tool your team uses every day."
      : "Sistemas de gestión, dashboards, integraciones, apps internas. Construyo la herramienta digital que tu equipo usa todos los días.",
    cta: en ? "Let's start with a call" : "Arranquemos por una llamada",
    href: "#contacto",
  },
  {
    n: "02",
    q: en ? "Is your current landing page taking over a month to close deals?" : "¿Tu landing actual tarda más de un mes en cerrar deals?",
    a: en
      ? "A professional site in 2-3 weeks. Design, code, basic SEO and deploy. You maintain it or I do — your call."
      : "Sitio profesional en 2-3 semanas. Diseño, código, SEO básico y deploy. Vos lo mantenés o yo lo mantengo — vos decidís.",
    cta: showPackages ? (en ? "I want my landing page" : "Quiero mi landing") : en ? "Let's talk on WhatsApp" : "Hablemos por WhatsApp",
    href: showPackages
      ? "#paquete-lanzar"
      : en
        ? "https://wa.me/50685082921?text=Hi Jonathan! I'd like to talk about a landing page."
        : "https://wa.me/50685082921?text=¡Hola, Jonathan! Quiero conversar sobre una landing page.",
    external: !showPackages,
  },
  {
    n: "03",
    q: en ? "Want a mobile app but not sure where to start?" : "¿Querés una app móvil pero no sabés por dónde empezar?",
    a: en
      ? "Flutter apps in production for Walmart, BCR and PriceSmart. I know what breaks, what lasts and what scales. We start with a conversation."
      : "Apps Flutter en producción para Walmart, BCR y PriceSmart. Sé qué se rompe, qué dura y qué escala. Empezamos por la conversación.",
    cta: en ? "Let's talk about the app" : "Hablemos de la app",
    href: en
      ? "https://wa.me/50685082921?text=Hi Jonathan! I'd like to talk about a mobile app."
      : "https://wa.me/50685082921?text=¡Hola, Jonathan! Quiero hablar sobre una app móvil.",
    external: true,
  },
];
---

<section
  id="caminos"
  class="border-y"
  style="border-color: var(--color-line); background-color: var(--color-bg);"
>
  <div class="container-x py-20 md:py-28">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.4fr] lg:gap-16 mb-14 md:mb-20">
      <div class="reveal">
        <div class="label mb-4">{en ? 'Paths' : 'Caminos'}</div>
        <h2 class="display-xl" style="color: var(--color-text);">
          {en ? 'Three questions.' : 'Tres preguntas.'}<br />
          <span class="mark-accent">{en ? 'Three paths.' : 'Tres caminos.'}</span>
        </h2>
      </div>
      <p
        class="reveal reveal-d1 text-[1.0625rem] leading-relaxed self-end max-w-[58ch]"
        style="color: var(--color-text-mute);"
      >
        {
          en
            ? 'Three kinds of clients, three ways to start. If one of these sounds familiar, you already know where we begin.'
            : 'Tres tipos de cliente, tres formas de empezar. Si te suena una de estas, ya sabés por dónde arrancamos.'
        }
      </p>
    </div>

    <div class="grid gap-px md:grid-cols-3 surface overflow-hidden">
      {questions.map((item, i) => (
        <a
          href={item.href}
          target={item.external ? "_blank" : undefined}
          rel={item.external ? "noopener noreferrer" : undefined}
          class={`group block p-7 md:p-9 transition-colors duration-200 relative reveal reveal-d${i + 1}`}
          style="background-color: var(--color-surface);"
          onmouseover="this.style.backgroundColor='var(--color-surface-2)'"
          onmouseout="this.style.backgroundColor='var(--color-surface)'"
        >
          <div
            class="font-mono tabular-nums mb-7"
            style="font-size: 0.78rem; letter-spacing: 0.18em; color: var(--color-accent);"
          >
            {item.n}
          </div>
          <h3
            class="display-l mb-5"
            style="font-size: clamp(1.375rem, 2vw, 1.625rem); color: var(--color-text); line-height: 1.1;"
          >
            {item.q}
          </h3>
          <p class="text-[0.95rem] leading-relaxed mb-7 max-w-[42ch]" style="color: var(--color-text-mute);">
            {item.a}
          </p>
          <div
            class="inline-flex items-center gap-2 text-[0.875rem] font-semibold transition-transform duration-200 group-hover:translate-x-1"
            style="color: var(--color-accent);"
          >
            {item.cta}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
