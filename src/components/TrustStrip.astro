---
const clients = [
  "Walmart vía IDS",
  "Banco de Costa Rica",
  "PriceSmart",
  "ACDEMIC",
  "Living Stone Contractors",
  "Professional Construction",
  "NetFic Solutions",
];

const items = [...clients, ...clients];
---

<section
  class="border-y"
  style="border-color: var(--color-line); background-color: var(--color-surface);"
  aria-label="Trabajo con empresas"
>
  <div class="container-x py-5 md:py-6 grid gap-6 md:grid-cols-[auto_1fr] md:items-center">
    <div class="label shrink-0" style="color: var(--color-text-mute);">
      Trabajo / he trabajado con
    </div>
    <div class="marquee">
      <div class="marquee-track">
        {items.map((client) => (
          <div class="flex items-center gap-3.5 shrink-0">
            <span
              class="inline-block h-1.5 w-1.5 rounded-full shrink-0"
              style="background-color: var(--color-accent);"
            ></span>
            <span
              class="font-display font-semibold whitespace-nowrap"
              style="font-size: 1.125rem; letter-spacing: -0.025em; color: var(--color-text);"
            >
              {client}
            </span>
          </div>
        ))}
      </div>
      <div class="marquee-track" aria-hidden="true">
        {items.map((client) => (
          <div class="flex items-center gap-3.5 shrink-0">
            <span
              class="inline-block h-1.5 w-1.5 rounded-full shrink-0"
              style="background-color: var(--color-accent);"
            ></span>
            <span
              class="font-display font-semibold whitespace-nowrap"
              style="font-size: 1.125rem; letter-spacing: -0.025em; color: var(--color-text);"
            >
              {client}
            </span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
