---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import QuestionCTAs from '../components/QuestionCTAs.astro';
import Packages from '../components/Packages.astro';
import Projects from '../components/Projects.astro';
import Process from '../components/Process.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { useTranslations } from '../i18n/utils';
import { showPackages } from '../utils/flags';

const lang = 'en' as const;
const t = useTranslations(lang);
---

<BaseLayout
  title="Jonathan Cruz · Custom software for your business"
  description="I build custom software for companies, founders and entrepreneurs in Costa Rica. Mobile apps, websites and systems with solid architecture. WhatsApp direct."
  lang={lang}
>
  <Nav lang={lang} t={t} />
  <main>
    <Hero t={t} lang={lang} />
    <TrustStrip lang={lang} />
    <QuestionCTAs lang={lang} />
    {showPackages && <Packages t={t} lang={lang} />}
    <Projects t={t} lang={lang} />
    <Process lang={lang} />
    <About t={t} lang={lang} />
    <Contact t={t} lang={lang} />
  </main>
  <Footer t={t} lang={lang} />
</BaseLayout>
