---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { useTranslations } from '../../i18n/utils';

const lang = 'en' as const;
const t = useTranslations(lang);
const cv = t.cv;
const backHref = '/en/';

const linkedinUrl = 'https://www.linkedin.com/in/xnjaca/';
const linkedinLabel = 'linkedin.com/in/xnjaca';

const ctaLabels = {
  meta: 'CV',
  location: 'Location',
  email: 'Email',
  whatsapp: 'WhatsApp',
  linkedin: 'LinkedIn',
  closingEyebrow: 'Looking for someone for your team or project?',
  closingHeadline: "Let's talk",
  closingBody: 'For something quick, WhatsApp. For something long, email or LinkedIn. Response within 24 business hours.',
};
---

<BaseLayout title={cv.pageTitle} description={cv.pageDescription} lang={lang}>
  <Nav lang={lang} t={t} />

  <main>
    <section class="container-x relative pt-12 md:pt-20 pb-16 md:pb-20">
      <a
        href={backHref}
        class="reveal inline-flex items-center gap-2 text-[0.85rem] font-medium mb-10 transition-colors"
        style="color: var(--color-text-mute);"
        onmouseover="this.style.color='var(--color-accent)'"
        onmouseout="this.style.color='var(--color-text-mute)'"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        {cv.back}
      </a>

      <div class="label reveal mb-5" style="color: var(--color-accent);">{ctaLabels.meta} · {cv.role}</div>

      <h1 class="reveal reveal-d1 display-mega" style="color: var(--color-text);">
        Jonathan<br />
        Cruz <span class="mark-accent">Ayala</span>.
      </h1>

      <div class="reveal reveal-d3 mt-10 grid gap-px md:grid-cols-2 lg:grid-cols-4 surface overflow-hidden">
        <div class="p-5">
          <div class="label mb-2">{ctaLabels.location}</div>
          <div class="text-[0.95rem] font-medium" style="color: var(--color-text);">{cv.contact.location}</div>
        </div>
        <div class="p-5">
          <div class="label mb-2">{ctaLabels.email}</div>
          <a href={`mailto:${cv.contact.email}`} class="text-[0.95rem] font-medium hover:underline" style="color: var(--color-text);">
            {cv.contact.email}
          </a>
        </div>
        <div class="p-5">
          <div class="label mb-2">{ctaLabels.whatsapp}</div>
          <a href="https://wa.me/50685082921" target="_blank" rel="noopener noreferrer" class="text-[0.95rem] font-medium tabular-nums hover:underline" style="color: var(--color-text);">
            {cv.contact.phone}
          </a>
        </div>
        <div class="p-5">
          <div class="label mb-2">{ctaLabels.linkedin}</div>
          <a href={linkedinUrl} target="_blank" rel="noopener noreferrer" class="text-[0.95rem] font-medium hover:underline inline-flex items-center gap-1.5" style="color: var(--color-text);">
            {linkedinLabel}
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <line x1="7" y1="17" x2="17" y2="7"></line>
              <polyline points="7 7 17 7 17 17"></polyline>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <section class="border-y" style="border-color: var(--color-line); background-color: var(--color-surface);">
      <div class="container-x py-14 md:py-20">
        <div class="grid gap-10 lg:grid-cols-[1fr_2.4fr] lg:gap-16">
          <div class="reveal">
            <div class="label" style="color: var(--color-accent);">01</div>
            <h2 class="display-l mt-2" style="font-size: clamp(1.625rem, 2.6vw, 2rem); color: var(--color-text);">
              {cv.summary.label}
            </h2>
          </div>
          <p class="reveal reveal-d1 text-[1.0625rem] leading-relaxed max-w-[68ch]" style="color: var(--color-text);">
            {cv.summary.body}
          </p>
        </div>
      </div>
    </section>

    <section class="container-x py-16 md:py-24">
      <div class="grid gap-10 lg:grid-cols-[1fr_2.4fr] lg:gap-16">
        <div class="reveal">
          <div class="label" style="color: var(--color-accent);">02</div>
          <h2 class="display-l mt-2" style="font-size: clamp(1.625rem, 2.6vw, 2rem); color: var(--color-text);">
            {cv.experience.label}
          </h2>
        </div>

        <ol class="flex flex-col">
          {cv.experience.items.map((item, i) => (
            <li class={`reveal reveal-d${Math.min(i + 1, 5)} grid gap-3 md:grid-cols-[180px_1fr] md:gap-8 py-7 md:py-8 ${i === 0 ? '' : 'border-t'}`} style="border-color: var(--color-line);">
              <div class="flex items-start gap-3">
                <span
                  class="inline-block h-1.5 w-1.5 rounded-full shrink-0 mt-2"
                  style="background-color: var(--color-accent);"
                ></span>
                <div class="label tabular-nums" style="color: var(--color-accent);">
                  {item.dates}
                </div>
              </div>
              <article>
                <h3
                  class="font-display font-semibold leading-snug"
                  style="font-size: clamp(1.125rem, 1.8vw, 1.375rem); letter-spacing: -0.02em; color: var(--color-text);"
                >
                  {item.role}
                </h3>
                <p class="mt-1 text-[0.95rem]" style="color: var(--color-text-mute);">
                  {item.company}
                </p>
                <ul class="mt-5 flex flex-col gap-2.5 max-w-[68ch]">
                  {item.bullets.map((b) => (
                    <li class="text-[0.95rem] leading-relaxed pl-5 relative" style="color: var(--color-text);">
                      <span
                        aria-hidden="true"
                        class="absolute left-0 top-[0.62em] inline-block h-1 w-1 rounded-full"
                        style="background-color: var(--color-accent);"
                      ></span>
                      {b}
                    </li>
                  ))}
                </ul>
              </article>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="border-y" style="border-color: var(--color-line); background-color: var(--color-surface);">
      <div class="container-x py-16 md:py-20">
        <div class="grid gap-10 lg:grid-cols-[1fr_2.4fr] lg:gap-16">
          <div class="reveal">
            <div class="label" style="color: var(--color-accent);">03</div>
            <h2 class="display-l mt-2" style="font-size: clamp(1.625rem, 2.6vw, 2rem); color: var(--color-text);">
              {cv.skills.label}
            </h2>
          </div>
          <div class="reveal reveal-d1 flex flex-col gap-7">
            {cv.skills.groups.map((g) => (
              <div class="grid gap-3 md:grid-cols-[180px_1fr] md:gap-6">
                <div class="label" style="color: var(--color-text);">
                  {g.name}
                </div>
                <ul class="flex flex-wrap gap-1.5">
                  {g.items.map((item) => (
                    <li
                      class="px-2.5 py-1 text-[0.78rem] rounded-md font-mono"
                      style="background-color: var(--color-bg); color: var(--color-text); border: 1px solid var(--color-line);"
                    >
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="container-x py-16 md:py-20 border-b" style="border-color: var(--color-line);">
      <div class="grid gap-10 lg:grid-cols-[1fr_2.4fr] lg:gap-16">
        <div class="reveal">
          <div class="label" style="color: var(--color-accent);">04</div>
          <h2 class="display-l mt-2" style="font-size: clamp(1.625rem, 2.6vw, 2rem); color: var(--color-text);">
            {cv.education.label}
          </h2>
        </div>
        <div class="reveal reveal-d1">
          <p class="text-[1.0625rem] font-medium" style="color: var(--color-text);">
            {cv.education.degree}
          </p>
          <p class="mt-2 text-[0.95rem]" style="color: var(--color-text-mute);">
            {cv.education.languages}
          </p>
        </div>
      </div>
    </section>

    <section class="container-x py-16 md:py-20">
      <div class="surface p-8 md:p-12 reveal">
        <div class="grid gap-8 lg:grid-cols-[1.5fr_1fr] lg:gap-12 lg:items-center">
          <div>
            <div class="label mb-4">{ctaLabels.closingEyebrow}</div>
            <h2 class="display-xl" style="color: var(--color-text); font-size: clamp(1.875rem, 3.6vw, 2.75rem);">
              <span class="mark-accent">{ctaLabels.closingHeadline}</span>.
            </h2>
            <p class="mt-5 max-w-[52ch] text-[1rem] leading-relaxed" style="color: var(--color-text-mute);">
              {ctaLabels.closingBody}
            </p>
          </div>
          <div class="flex flex-wrap gap-3 lg:justify-end">
            <a
              href="https://wa.me/50685082921?text=Hi Jonathan! I saw your CV and would like to talk."
              target="_blank"
              rel="noopener noreferrer"
              class="btn-wa"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.002-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
              </svg>
              WhatsApp
            </a>
            <a href={linkedinUrl} target="_blank" rel="noopener noreferrer" class="btn-ghost">
              LinkedIn
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </a>
            <a href="mailto:xnjaca@gmail.com" class="btn-ghost">
              {cv.contact.email}
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="container-x py-10 border-t" style="border-color: var(--color-line);">
      <a
        href={backHref}
        class="group inline-flex items-center gap-2 text-[0.9rem] font-medium transition-opacity hover:opacity-70"
        style="color: var(--color-text);"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:-translate-x-0.5">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>{cv.back}</span>
      </a>
    </section>
  </main>

  <Footer t={t} lang={lang} />
</BaseLayout>
