---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import { useTranslations } from '../../../i18n/utils';

const lang = 'en' as const;
const t = useTranslations(lang);
const idx = t.projectPages.index;
const items = t.projects.items;

const entries = [
  { key: 'acdemic' as const, data: items.acdemic, caseStudyHref: '/en/projects/acdemic' as const },
  { key: 'professionalConstruction' as const, data: items.professionalConstruction, caseStudyHref: '/en/projects/professional-construction' as const },
  { key: 'livingstoneContractors' as const, data: items.livingstoneContractors, caseStudyHref: '/en/projects/livingstone-contractors' as const },
  { key: 'netfic' as const, data: items.netfic, caseStudyHref: '/en/projects/netfic' as const },
  { key: 'walmart' as const, data: items.walmart, confidential: true },
  { key: 'bcr' as const, data: items.bcr, confidential: true },
  { key: 'priceSmart' as const, data: items.priceSmart, confidential: true },
];

const backHref = '/en/';
const total = entries.length;
const caseStudyCount = entries.filter((e) => 'caseStudyHref' in e).length;
const ndaCount = entries.filter((e) => 'confidential' in e).length;
---

<BaseLayout title={idx.pageTitle} description={idx.pageDescription} lang={lang} noStructuredData>
  <Nav lang={lang} t={t} />

  <main>
    <section class="container-x relative pt-12 md:pt-20 pb-16 md:pb-20">
      <a
        href={backHref}
        class="reveal inline-flex items-center gap-2 text-[0.85rem] font-medium mb-10 transition-colors"
        style="color: var(--color-text-mute);"
        onmouseover="this.style.color='var(--color-accent)'"
        onmouseout="this.style.color='var(--color-text-mute)'"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        {idx.backToHome}
      </a>

      <div class="grid gap-10 lg:grid-cols-[1.6fr_1fr] lg:gap-16 lg:items-end">
        <div>
          <div class="label reveal mb-5" style="color: var(--color-accent);">
            {idx.sectionNumber}
          </div>
          <h1 class="reveal reveal-d1 display-mega" style="color: var(--color-text);">
            Recent work,<br />
            in <span class="mark-accent">detail</span>.
          </h1>
          <p class="reveal reveal-d2 mt-8 max-w-[58ch]" style="font-size: 1.125rem; line-height: 1.55; color: var(--color-text-mute);">
            {idx.description}
          </p>
        </div>

        <aside class="reveal reveal-d2 lg:pb-2 self-end">
          <div class="surface p-6 md:p-7">
            <div class="grid grid-cols-3 gap-4">
              <div>
                <div class="font-display tabular-nums leading-none" style="font-size: 2rem; letter-spacing: -0.04em; color: var(--color-accent);">{total}</div>
                <div class="mt-2 label">total</div>
              </div>
              <div>
                <div class="font-display tabular-nums leading-none" style="font-size: 2rem; letter-spacing: -0.04em; color: var(--color-text);">{caseStudyCount}</div>
                <div class="mt-2 label">case studies</div>
              </div>
              <div>
                <div class="font-display tabular-nums leading-none" style="font-size: 2rem; letter-spacing: -0.04em; color: var(--color-gold);">{ndaCount}</div>
                <div class="mt-2 label">under NDA</div>
              </div>
            </div>
          </div>
        </aside>
      </div>
    </section>

    <section class="container-x pb-16 md:pb-24">
      <div class="surface overflow-hidden">
        {entries.map((entry, i) => {
          const isLink = 'caseStudyHref' in entry;
          const isLast = i === entries.length - 1;
          const Tag = isLink ? 'a' : 'article';
          const linkProps = isLink ? { href: entry.caseStudyHref } : {};
          const num = String(i + 1).padStart(2, '0');
          return (
            <Tag
              {...linkProps}
              class={`group block grid gap-6 lg:grid-cols-[80px_1.5fr_1fr] lg:gap-10 px-7 md:px-9 py-10 md:py-12 ${isLast ? '' : 'border-b'} ${isLink ? 'transition-colors duration-200' : ''} reveal reveal-d${Math.min((i % 4) + 1, 4)}`}
              style="border-color: var(--color-line);"
              onmouseover={isLink ? "this.style.backgroundColor='var(--color-surface-2)'" : undefined}
              onmouseout={isLink ? "this.style.backgroundColor='transparent'" : undefined}
            >
              <div
                class="font-display tabular-nums leading-none self-start"
                style="font-weight: 700; font-size: clamp(2rem, 3vw, 2.75rem); letter-spacing: -0.04em; color: var(--color-accent);"
              >
                {num}
              </div>
              <div>
                <div class="flex items-center gap-3 mb-3 flex-wrap">
                  <span class="label">{entry.data.label}</span>
                  {entry.confidential && (
                    <>
                      <span style="color: var(--color-line);">·</span>
                      <span class="label" style="color: var(--color-gold);">{idx.confidentialLabel}</span>
                    </>
                  )}
                  {isLink && (
                    <>
                      <span style="color: var(--color-line);">·</span>
                      <span class="label" style="color: var(--color-accent);">{idx.caseStudyLabel}</span>
                    </>
                  )}
                </div>
                <div class="flex items-baseline gap-3">
                  <h2 class="display-l" style="font-size: clamp(1.875rem, 3vw, 2.5rem); color: var(--color-text); line-height: 1;">
                    {entry.data.name}
                  </h2>
                  {isLink && (
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:translate-x-1" style="color: var(--color-accent);">
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                      <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                  )}
                </div>
                <p class="mt-2 text-[0.95rem] font-medium" style="color: var(--color-text);">
                  {entry.data.tagline}
                </p>
                <p class="mt-4 text-[0.9rem] leading-relaxed max-w-[58ch]" style="color: var(--color-text-mute);">
                  {entry.data.description}
                </p>
              </div>
              <div class="lg:pt-3">
                <div class="label mb-3">{t.projects.stackLabel}</div>
                <ul class="flex flex-wrap gap-1.5">
                  {entry.data.stack.map((tech) => (
                    <li
                      class="px-2.5 py-1 text-[0.72rem] rounded-md font-mono"
                      style="background-color: var(--color-surface-2); color: var(--color-text-mute); border: 1px solid var(--color-line);"
                    >
                      {tech}
                    </li>
                  ))}
                </ul>
              </div>
            </Tag>
          );
        })}
      </div>
    </section>

    <section class="container-x py-16 md:py-20">
      <div class="surface p-8 md:p-12 reveal">
        <div class="grid gap-8 lg:grid-cols-[1.5fr_1fr] lg:gap-12 lg:items-center">
          <div>
            <div class="label mb-4">Interested in any of these?</div>
            <h2 class="display-xl" style="color: var(--color-text); font-size: clamp(1.875rem, 3.6vw, 2.75rem);">
              Let's talk about your <span class="mark-accent">project</span>.
            </h2>
            <p class="mt-5 max-w-[52ch] text-[1rem] leading-relaxed" style="color: var(--color-text-mute);">
              Quote via WhatsApp or email. Response within 24 business hours.
            </p>
          </div>
          <div class="flex flex-wrap gap-3 lg:justify-end">
            <a
              href="https://wa.me/50685082921?text=Hi Jonathan! I saw your projects and would like to talk."
              target="_blank"
              rel="noopener noreferrer"
              class="btn-wa"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.002-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
              </svg>
              WhatsApp
            </a>
            <a href="mailto:xnjaca@gmail.com" class="btn-ghost">
              xnjaca@gmail.com
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="container-x py-10 border-t" style="border-color: var(--color-line);">
      <a
        href={backHref}
        class="group inline-flex items-center gap-2 text-[0.9rem] font-medium transition-opacity hover:opacity-70"
        style="color: var(--color-text);"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:-translate-x-0.5">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>{idx.backToHome}</span>
      </a>
    </section>
  </main>

  <Footer t={t} lang={lang} />
</BaseLayout>
