---
import { ViewTransitions } from 'astro:transitions';
import '../styles/global.css';
import type { Lang } from '../i18n/utils';
import WhatsAppFloat from '../components/WhatsAppFloat.tsx';

interface Props {
  title: string;
  description?: string;
  lang: Lang;
  ogImage?: string;
  noStructuredData?: boolean;
}

const {
  title,
  description = '',
  lang,
  ogImage,
  noStructuredData = false,
} = Astro.props;

const site = Astro.site?.toString().replace(/\/$/, '') ?? '';

const rawPath = Astro.url.pathname;
let cleanPath = rawPath;
if (rawPath.startsWith('/es/')) cleanPath = rawPath.slice(3);
else if (rawPath === '/es') cleanPath = '/';

const enUrl = `${site}${cleanPath}`;
const esUrl = cleanPath === '/' ? `${site}/es/` : `${site}/es${cleanPath}`;
const canonicalUrl = lang === 'es' ? esUrl : enUrl;
const ogImageUrl = ogImage ?? `${site}/og.png`;

const ogLocale = lang === 'es' ? 'es_CR' : 'en_US';
const ogLocaleAlt = lang === 'es' ? 'en_US' : 'es_CR';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Jonathan Cruz Ayala',
  url: site,
  email: 'mailto:xnjaca@gmail.com',
  jobTitle: 'Software Engineer · Full-stack & Mobile',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'San José',
    addressCountry: 'CR',
  },
  sameAs: ['https://linkedin.com/in/xnjaca'],
  knowsAbout: ['Flutter', 'Node.js', 'TypeScript', 'NestJS', 'Angular', 'PostgreSQL'],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Jonathan Cruz Ayala" />
    <meta name="theme-color" content="#0e0e10" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Jonathan Cruz Ayala" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {!noStructuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    )}

    <ViewTransitions />
  </head>
  <body>
    <slot />
    <WhatsAppFloat client:load lang={lang} />

    <script>
      function initScrollReveal() {
        const els = document.querySelectorAll('.reveal, .reveal-on-scroll');
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
        );
        els.forEach((el) => observer.observe(el));
      }

      initScrollReveal();
      document.addEventListener('astro:after-swap', initScrollReveal);
    </script>
  </body>
</html>
